---
import type { CatalogMeta } from '../types/catalog';

interface Props {
  meta?: Pick<CatalogMeta, 'brand'>;
}

const { meta = { brand: 'Grano x Grano' } } = Astro.props;
const links = [
  { href: '#portada', label: 'Portada' },
  { href: '#mezcla-tradicional', label: 'Tradicional' },
  { href: '#mezclas-gourmet', label: 'Gourmet' },
  { href: '#mezclas-especiales', label: 'Especiales' },
  { href: '#microlotes-selectos', label: 'Microlotes' },
  { href: '#historias', label: 'Historias' },
];
---
<header class="index" aria-label="Índice del catálogo">
  <div class="index-inner">
    <a class="index-brand" href="#portada">{meta.brand}</a>
    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="index-menu"
      aria-label="Abrir menú"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <nav id="index-menu" aria-label="Secciones">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.index');
  const btn = document.querySelector('.menu-btn');
  const menu = document.getElementById('index-menu');

  if (header instanceof HTMLElement && btn instanceof HTMLButtonElement && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };

    btn.addEventListener('click', () => setOpen(!header.classList.contains('open')));

    menu.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('open')) {
        setOpen(false);
        btn.focus();
      }
    });

    window.matchMedia('(max-width: 640px)').addEventListener('change', (event) => {
      if (!event.matches) setOpen(false);
    });
  }
</script>
