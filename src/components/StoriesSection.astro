---
import type { Story } from '../types/catalog';
import Badge from './Badge.astro';

interface Props {
  heading: string;
  stories: Story[];
}

const { heading, stories } = Astro.props;

const tones: Record<string, { tone: 'gaia' | 'aura' | 'helios' | 'aether'; icon: string; name: string }> = {
  gaia: { tone: 'gaia', icon: '❧', name: 'GAIA' },
  aura: { tone: 'aura', icon: '♨', name: 'AURA' },
  helios: { tone: 'helios', icon: '☀', name: 'HELIOS' },
  aether: { tone: 'aether', icon: '☁', name: 'AETHER' },
};
---
<section class="page historias" id="historias" aria-labelledby="historias-titulo">
  <div class="wrap">
    <h2 class="display historias-title" id="historias-titulo">{heading}</h2>
    <div class="long-rule" aria-hidden="true"></div>
    {stories.map((story, i) => (
      <div>
        <div class="story-row">
          <Badge
            name={tones[story.id]?.name ?? story.name}
            icon={tones[story.id]?.icon ?? '❧'}
            tone={tones[story.id]?.tone ?? 'gaia'}
            small
          />
          <div>
            <h3>{story.name} — {story.title}</h3>
            <p class="tagline">{story.tagline}</p>
            <p class="desc">{story.description}</p>
          </div>
        </div>
        {i < stories.length - 1 && <div class="short-rule" aria-hidden="true"></div>}
      </div>
    ))}
  </div>
</section>
