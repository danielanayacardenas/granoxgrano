---
import type { Story } from '../types/catalog';
import Badge from './Badge.astro';

interface Props {
  heading: string;
  stories: Story[];
}

const { heading, stories } = Astro.props;

const tones: Record<string, 'gaia' | 'aura' | 'helios' | 'aether'> = {
  gaia: 'gaia',
  aura: 'aura',
  helios: 'helios',
  aether: 'aether',
};
---
<section class="page historias reveal" id="historias" aria-labelledby="historias-titulo">
  <div class="wrap">
    <h2 class="display historias-title" id="historias-titulo">{heading}</h2>
    <div class="long-rule" aria-hidden="true"></div>
    {stories.map((story, i) => (
      <div>
        <div class="story-row">
          <Badge
            tone={tones[story.id] ?? 'gaia'}
            small
          />
          <div>
            <h3>{story.name} — {story.title}</h3>
            <p class="tagline">{story.tagline}</p>
            <p class="desc">{story.description}</p>
          </div>
        </div>
        {i < stories.length - 1 && <div class="short-rule" aria-hidden="true"></div>}
      </div>
    ))}
  </div>
</section>
