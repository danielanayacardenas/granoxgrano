---
import { Picture } from 'astro:assets';
import type { GourmetSection } from '../types/catalog';
import PriceList from './PriceList.astro';
import Badge from './Badge.astro';
import SectionHeader from './ui/SectionHeader.astro';
import coffeeSection from '../assets/coffeeSection.png';

interface Props {
  gourmet: GourmetSection;
}

const { gourmet } = Astro.props;
---
<section class="page reveal" id={gourmet.id} aria-labelledby={`${gourmet.id}-titulo`}>
  <div class="wrap gourmet-grid">
    <div class="gourmet-head">
      <div>
        <SectionHeader title={gourmet.title} subtitle={gourmet.subtitle} id={gourmet.id} />
        <p class="gourmet-sub">{gourmet.intro}</p>
        <div class="gourmet-profiles">
          {gourmet.profiles.map((profile) => (
            <div>
              <h3>{profile.name}:</h3>
              <dl>
                <dt>A: </dt><dd>{profile.acidity}</dd>
                <dt>D: </dt><dd>{profile.sweetness}</dd>
                <dt>C: </dt><dd>{profile.body}</dd>
              </dl>
            </div>
          ))}
        </div>
        <p class="legend">{gourmet.legend}</p>
        <PriceList prices={gourmet.prices} />
      </div>
      <Badge tone="aura" />
    </div>
  </div>
</section>
<div class="bean-strip" aria-hidden="true">
  <Picture
    src={coffeeSection}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    widths={[480, 768, 1080, 1600]}
    sizes="100vw"
    alt=""
    loading="lazy"
    decoding="async"
    class="bean-img"
  />
</div>
