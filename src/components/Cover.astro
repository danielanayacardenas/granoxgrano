---
import type { CatalogMeta } from '../types/catalog';

interface Props {
  meta: CatalogMeta;
}

const { meta } = Astro.props;
---
<section class="cover" id="portada" aria-label={`Portada ${meta.brand}`}>
  <div class="cover-inner">
    <div class="cover-top">
      <h1 class="cover-title">{meta.title}</h1>
      <p class="cover-brand">{meta.brand}</p>
      <p class="cover-subtitle">{meta.motto}</p>
    </div>
    <div class="cover-foot">
      <p class="tag">{meta.tagline}</p>
      <p class="est">- EST. 2017 -</p>
    </div>
  </div>
</section>
