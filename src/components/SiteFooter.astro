---
import type { CatalogMeta } from '../types/catalog';

interface Props {
  meta: CatalogMeta;
}

const { meta } = Astro.props;
---
<footer class="footer reveal" aria-label={`Cierre del catálogo ${meta.brand}`}>
  <div class="seal" aria-hidden="true">G</div>
  <p class="footer-meta">{meta.brand} · {meta.motto} {meta.edition}</p>
  <a class="instagram" href={meta.instagram.url} target="_blank" rel="noreferrer">
    {meta.instagram.handle}
  </a>
</footer>
