---
import type { SpecialVariety } from '../types/catalog';
import { getSpecialsColumns } from '../lib/catalog';
import Badge from './Badge.astro';
import SectionHeader from './ui/SectionHeader.astro';
import VarietyCard from './ui/VarietyCard.astro';

interface Props {
  id?: string;
  title: string;
  subtitle: string;
  specials: SpecialVariety[];
}

const { id = 'mezclas-especiales', title, subtitle, specials } = Astro.props;

const { left, right } = getSpecialsColumns(specials);
---
<section class="page reveal" id={id} aria-labelledby="especiales-titulo">
  <div class="wrap">
    <div class="especiales-head">
      <SectionHeader title={title} subtitle={subtitle} id="especiales" />
      <Badge tone="helios" />
    </div>
    <div class="especiales-cols">
      <div>
        {left.map((item) => (
          <VarietyCard item={item} />
        ))}
      </div>
      <div class="right">
        {right.map((item) => (
          <VarietyCard item={item} align="right" />
        ))}
      </div>
    </div>
  </div>
</section>
