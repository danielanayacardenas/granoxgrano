---
import { Picture } from 'astro:assets';
import type { BadgeTone } from '../types/catalog';
import gaia from '../assets/badges/gaia.png';
import aura from '../assets/badges/aura.png';
import helios from '../assets/badges/helios.png';
import aether from '../assets/badges/aether.png';

interface Props {
  tone: BadgeTone;
  small?: boolean;
}

const { tone, small = false } = Astro.props;

const badges = {
  gaia,
  aura,
  helios,
  aether,
};
---
<div class:list={['badge-svg', tone, { small }]} aria-hidden="true">
  <div class="badge-frame">
    <Picture
      src={badges[tone]}
      formats={['avif', 'webp']}
      fallbackFormat="png"
      widths={small ? [92] : [120, 136, 168]}
      sizes={small ? '92px' : '(max-width: 640px) 120px, 136px'}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .badge-svg {
    width: 168px;
    flex: none;
    display: flex;
    justify-content: center;
  }
  .badge-frame {
    width: min(100%, 136px);
    aspect-ratio: 0.62;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .badge-frame :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .badge-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .badge-svg.small {
    width: 92px;
  }
  .badge-svg.small .badge-frame {
    width: 100%;
  }
</style>
