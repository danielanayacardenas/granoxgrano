---
import type { TraditionalBlend } from '../types/catalog';
import PriceList from './PriceList.astro';
import Badge from './Badge.astro';
import SectionHeader from './ui/SectionHeader.astro';

interface Props {
  blend: TraditionalBlend;
}

const { blend } = Astro.props;
---
<section class="page reveal" id={blend.id} aria-labelledby={`${blend.id}-titulo`}>
  <div class="wrap tradicional-grid">
    <Badge tone="gaia" />
    <div>
      <SectionHeader title={blend.title} subtitle={blend.subtitle} id={blend.id} />
      <p class="blend-desc">{blend.description}</p>
      <PriceList prices={blend.prices} status={blend.status} />
    </div>
  </div>
</section>
