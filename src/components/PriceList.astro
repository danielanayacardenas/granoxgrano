---
import type { Price } from '../types/catalog';
import { formatPrice, getPriceUnit, hasWholesale } from '../lib/catalog';

interface Props {
  prices: Price;
  align?: 'left' | 'right';
  status?: string;
}

const { prices, align = 'left', status } = Astro.props;
const unit = ` ${getPriceUnit(prices)}`;
---
<div class:list={['price-lines', { 'price-lines--right': align === 'right' }]} aria-label="Precios">
  <p>MINORISTA: {formatPrice(prices.retail)}{unit}</p>
  {hasWholesale(prices) && (
    <p>MAYOREO {prices.wholesaleNote ?? ''}: {formatPrice(prices.wholesale)}{unit}</p>
  )}
  {status && <span class="status-badge">{status}</span>}
</div>
