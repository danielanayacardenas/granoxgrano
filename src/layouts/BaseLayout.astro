---
import '../styles/global.css';
import type { CatalogMeta } from '../types/catalog';

interface Props {
  title?: string;
  description?: string;
  meta?: CatalogMeta;
}

const { meta, title: titleOverride, description: descriptionOverride } = Astro.props;

const title =
  titleOverride ??
  meta?.seoTitle ??
  `${meta?.brand ?? 'Grano x Grano'} — ${meta?.title ?? 'Catálogo'} ${meta?.motto ?? 'Café Cultura'} ${meta?.edition ?? '2026'}`;
const description =
  descriptionOverride ??
  meta?.seoDescription ??
  'Grano x Grano, Café Cultura 2026: mezclas tradicionales, gourmet, especiales, microlotes selectos e historias que se tuestan.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- La imagen de portada usa <Picture> con eager + fetchpriority en Cover.astro -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />

    <script src="../scripts/motion.ts"></script>
  </body>
</html>
