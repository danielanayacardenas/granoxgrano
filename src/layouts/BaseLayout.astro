---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Grano x Grano — Catálogo Café Cultura 2026',
  description = 'Grano x Grano, Café Cultura 2026: mezclas tradicionales, gourmet, especiales, microlotes selectos e historias que se tuestan.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- La imagen de portada usa <Picture> con eager + fetchpriority en Cover.astro -->
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = document.querySelectorAll('.reveal');
        
        if (prefersReducedMotion) {
          revealElements.forEach(el => el.classList.add('visible'));
          return;
        }
        
        // Immediately show elements already in viewport
        revealElements.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('visible');
          }
        });
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { 
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
          }
        );
        
        // Only observe elements not yet visible
        revealElements.forEach(el => {
          if (!el.classList.contains('visible')) {
            observer.observe(el);
          }
        });
        
        // Cover fade out on scroll (desktop con puntero fino: en táctil/móvil
        // el translate por scroll compite con el sticky nav y causa tirones)
        const cover = document.querySelector('.cover') as HTMLElement | null;
        const coverInner = document.querySelector('.cover-inner') as HTMLElement | null;
        const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
        const smallScreen = window.innerWidth <= 768;
        if (cover && coverInner && !coarsePointer && !smallScreen) {
          window.addEventListener('scroll', () => {
            const scrollY = window.scrollY;
            const fadeStart = 0;
            const fadeEnd = window.innerHeight * 0.5;
            const opacity = Math.max(0, 1 - (scrollY - fadeStart) / (fadeEnd - fadeStart));
            coverInner.style.opacity = String(opacity);
            coverInner.style.transform = `translateY(${scrollY * 0.3}px)`;
          }, { passive: true });
        }
      });
    </script>
  </body>
</html>
